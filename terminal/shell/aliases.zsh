# Optional developer shortcuts, installed by terminal/setup.sh --alias.
alias cls="clear"
alias developer='cd "$HOME/Developer"'
alias model="php artisan make:model"
alias migration-m="php artisan make:model -m"
alias migration="php artisan make:migration"
alias controller-r="php artisan make:controller --resource"
alias controller="php artisan make:controller"
alias migrate="php artisan migrate"
alias migrate-r="php artisan migrate:refresh"
alias volt="php artisan make:volt --class"
alias livewire="php artisan make:livewire"
alias folio="php artisan folio:page"
alias optimize="php artisan optimize:clear"
alias class="php artisan make:class"
alias request="php artisan make:request"
alias test="php artisan test"
alias test-m="php artisan make:test"
alias gc="git add . && git commit -m"
alias gp="git push origin"
alias gs="git switch"
alias gd="git pull"
alias reload="source ~/.zshrc"
alias phpstan="vendor/bin/phpstan analyse --level=10 app/ --configuration=phpstan.neon"
alias pint="vendor/bin/pint"
alias pest="vendor/bin/pest"
alias insights="php artisan insights"
alias wayfinder="php artisan wayfinder:generate --with-form"
alias artisan="php artisan"
alias actf='act -P ubuntu-latest=ghcr.io/catthehacker/ubuntu:act-latest --container-architecture linux/amd64'
alias pip="python3 -m pip"
alias pipv="[ -d .venv ] || python3 -m venv .venv"
alias pipa="source .venv/bin/activate"
alias pipd="deactivate"
alias expo-air='npx expo run:ios --device "iPhone Air"'
alias expo-max='npx expo run:ios --device "iPhone 17 Pro Max"'
alias expo-pro='npx expo run:ios --device "iPhone 17 Pro"'
